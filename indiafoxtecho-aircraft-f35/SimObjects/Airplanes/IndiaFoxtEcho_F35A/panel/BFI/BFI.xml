			<Element> <!-- BFI Horizon Marker -->
				<Position X="118" Y="213"/>
				<Image Name="BFI_Compass_Ref.bmp" ImageSizes="2,32" Bright="Yes"/>			
			</Element>			
		
		</Element>
		
		<Element>
		<Visible>(L:BFI_ALIGN,enum) 0 == (L:BFI_COMPASS_FAIL,enum) 1 == or 0 and</Visible>
			
			<Element> <!-- BFI Horizon Marker -->
				<Position X="44" Y="213"/>
				<Image Name="BFI_Compass_Fail.bmp" ImageSizes="158,33" Bright="Yes"/>			
			</Element>			
		
		</Element>	
	
	
		<Element>
		<Visible>(L:BFI_ALIGN,enum) 0 == </Visible>
			
			<Element> 
				<Position X="80" Y="145"/>
				<Text X="80" Y="20" Bright="Yes" Length="10" Font="Tahoma"  Bold="Yes" Color="#FFFFFF" Adjust="Center" VerticalAdjust="center">
					<String>ALIGNING</String>
				</Text>		
			</Element>			
			<Element> 
				<Position X="90" Y="170"/>
				<Text X="60" Y="20" Bright="Yes" Length="2" Font="Tahoma"  Bold="Yes" Color="#FFFFFF" Adjust="Center" VerticalAdjust="center">
