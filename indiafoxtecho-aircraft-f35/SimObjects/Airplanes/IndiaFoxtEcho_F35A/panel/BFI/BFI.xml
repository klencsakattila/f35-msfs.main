			</Shift>			
		</Element>
			
		<Element>
		<Visible>(L:BFI_ALIGN,enum) 1 == (L:BFI_COMPASS_FAIL,enum) 0 == and 1 or</Visible>
			
			<Element> <!-- BFI Compass Ruler -->
				<Position X="0" Y="0"/>
				<MaskImage Name="BFI_Compass_MASK.bmp" ImageSizes="247,245">
					<Axis X="119" Y="213"/>
				</MaskImage>
				<Image Name="BFI_Compass_Bar.bmp" ImageSizes="1368,32" Bright="Yes"/>
				<Shift>
					<Value Maximum="360" Minimum="0">(A:Plane heading degrees gyro, degrees)</Value>
					<Nonlinearity> 
						<Item Value="0" X="-149" Y="0"/>
						<Item Value="90" X="-416" Y="0"/>
						<Item Value="180" X="-683" Y="0"/>
						<Item Value="270" X="-950" Y="0"/>
						<Item Value="360" X="-1217" Y="0"/>					
					</Nonlinearity>
				</Shift>			
