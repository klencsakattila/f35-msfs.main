			<MaskImage Name="BFI_ASI_Digits_MASK.bmp" ImageSizes="247,245">
				<Axis X="0" Y="122"/>
			</MaskImage>
			<Image Name="BFI_ASI_Digits.bmp" ImageSizes="13,512" Bright="Yes"/>
			<Shift>
				<Value Maximum="10" Minimum="0">(L:AIRSPEED_Equivalent,number) 10 / 10 % flr </Value>
				<Nonlinearity> 
					<Item Value="0" X="15" Y="-256"/>
					<Item Value="10" X="15" Y="-25"/>
				</Nonlinearity>
			</Shift>			
