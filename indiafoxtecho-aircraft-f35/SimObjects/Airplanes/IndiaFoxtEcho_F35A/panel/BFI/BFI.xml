				<Nonlinearity> 
					<Item Value="0" X="231" Y="-256"/>
					<Item Value="10" X="231" Y="-25"/>
				</Nonlinearity>
			</Shift>			
		</Element>
		<Element> <!-- BFI Airspeed Indicator - Tape -->
			<Position X="0" Y="0"/>
			<MaskImage Name="BFI_ALT_Digits_MASK.bmp" ImageSizes="247,245">
				<Axis X="0" Y="122"/>
			</MaskImage>
			<Image Name="BFI_ASI_Digits.bmp" ImageSizes="13,512" Bright="Yes"/>
			<Shift>
				<Value Maximum="10" Minimum="0">(A:INDICATED ALTITUDE,feet) 100 / 10 % flr </Value>
				<Nonlinearity> 
					<Item Value="0" X="216" Y="-256"/>
					<Item Value="10" X="216" Y="-25"/>
				</Nonlinearity>
			</Shift>			
		</Element>
		<Element> <!-- BFI Airspeed Indicator - Tape -->
			<Position X="0" Y="0"/>
			<MaskImage Name="BFI_ALT_Digits_MASK.bmp" ImageSizes="247,245">
				<Axis X="0" Y="122"/>
			</MaskImage>
			<Image Name="BFI_ASI_Digits.bmp" ImageSizes="13,512" Bright="Yes"/>
