<Gauge Name="T-6B Backup Flight Instrument (BFI)" Version="1.0">


<Element>
<Visible>(A:ELECTRICAL MASTER BATTERY, bool) (L:BFI_Power, bool) and</Visible>
		
	<Element>
		<Image Name="BFI_BG.bmp" Transparent="Yes" ImageSizes="247,245" Bright="Yes"/>
		
		<Element>
		<Visible>(L:BFI_ALIGN,enum) 1 ==</Visible>
			<Element> <!-- BFI Pitch Ladder - No Ladder -->
				<Position X="0" Y="0"/>
				<MaskImage Name="BFI_Ladder_BG_MASK.bmp" ImageSizes="247,245">
					<Axis X="119" Y="116"/>
				</MaskImage>
				<Image Name="BFI_Ladder_BG.bmp" ImageSizes="450,821" Bright="Yes"/>
				<Shift>
					<Value Maximum="90" Minimum="-90">(A:PLANE PITCH DEGREES,degrees) /-/ </Value>
					<Nonlinearity> 
						<Item Value="90" X="-225" Y="-104"/>
						<Item Value="0" X="-225" Y="-410"/>
						<Item Value="-90" X="-225" Y="-716"/>
					</Nonlinearity>
				</Shift>	
				<Rotate>
					<Value>(A:PLANE BANK DEGREES,radians)</Value>
				</Rotate>				
			</Element>		

			<Element> <!-- BFI Pitch Ladder - Compass -->
				<Position X="0" Y="0"/>
				<MaskImage Name="BFI_Compass_MASK.bmp" ImageSizes="247,245">
					<Axis X="119" Y="116"/>
				</MaskImage>
				<Image Name="BFI_Compass_BG.bmp" ImageSizes="450,821" Bright="Yes"/>
				<Shift>
					<Value Maximum="90" Minimum="-90">(A:PLANE PITCH DEGREES,degrees) /-/ </Value>
					<Nonlinearity> 
						<Item Value="90" X="-225" Y="-104"/>
						<Item Value="0" X="-225" Y="-410"/>
						<Item Value="-90" X="-225" Y="-716"/>
					</Nonlinearity>
				</Shift>	
				<Rotate>
					<Value>(A:PLANE BANK DEGREES,radians)</Value>
				</Rotate>				
			</Element>			
			
			<Element> <!-- BFI Pitch Ladder - Ladder -->
				<Position X="0" Y="0"/>
				<MaskImage Name="BFI_Ladder_MASK.bmp" ImageSizes="247,245">
					<Axis X="119" Y="116"/>
				</MaskImage>
				<Image Name="BFI_Ladder_Full.bmp" ImageSizes="220,821" Bright="Yes"/>
				<Shift>
					<Value Maximum="90" Minimum="-90">(A:PLANE PITCH DEGREES,degrees) /-/ </Value>
					<Nonlinearity> 
						<Item Value="90" X="-110" Y="-104"/>
						<Item Value="0" X="-110" Y="-410"/>
						<Item Value="-90" X="-110" Y="-716"/>
					</Nonlinearity>
				</Shift>	
				<Rotate>
					<Value>(A:PLANE BANK DEGREES,radians)</Value>
				</Rotate>			
			</Element>	
			
			<Element> <!-- BFI Roll Marker -->
				<Position X="119" Y="116"/>
				<Image Name="BFI_Roll_Indicator.bmp" ImageSizes="12,7" Bright="Yes">
					<Axis X="5.5" Y="-75"/> 
				</Image>
				<Rotate>
					<Value>(A:PLANE BANK DEGREES,radians)</Value>
				</Rotate>			
			</Element>			
			
		</Element>		
		
		<Element> <!-- BFI ASI Tape Background -->
		<Position X="0" Y="0"/>
			<Image Name="BFI_ASI_Tape_BG.bmp" ImageSizes="247,245" Bright="Yes"/>			
